  "scripts": {
    "test": "node --test tests/rating-scale.test.mjs",
    "serve": "python3 -m http.server 8000",
    "check": "node --check js/all-rating.js && node --check js/rating-scale.js"
  },
  "repository": { "type": "git", "url": "git+https://github.com/squidjam/allRating.git" },
  "homepage": "https://squidjam.github.io/allRating/web-component.html",
